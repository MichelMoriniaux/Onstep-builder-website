# Copy to .env and adjust. Used by docker-compose.

# ABSOLUTE host path to this repo's ./data directory. REQUIRED for compose:
# the worker passes it to sibling runner containers as their bind-mount source.
# Example (Linux):  HOST_DATA_DIR=/srv/onstep-builder/data
HOST_DATA_DIR=/absolute/path/to/repo/data

# Public port for the web UI.
WEB_PORT=8088

# Build worker tuning.
WORKER_CONCURRENCY=2
BUILD_TIMEOUT_MS=900000
ARTIFACT_TTL_HOURS=24
